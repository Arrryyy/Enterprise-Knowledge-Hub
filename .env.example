# ============================================================================
# BRAIN MICROSERVICE CONFIGURATION
# ============================================================================

# Option 1: Azure OpenAI (Production)
# AZURE_SEARCH_SERVICE=your-search-service-name
# AZURE_SEARCH_INDEX=your-index-name
# AZURE_SEARCH_SERVICE_KEY=your-search-api-key
# AZURE_OPENAI_SERVICE=your-openai-service-name
# AZURE_OPENAI_DEPLOYMENT=gpt-4
# AZURE_OPENAI_MODEL=gpt-4
# AZURE_OPENAI_API_KEY_OVERRIDE=your-openai-api-key
# OPENAI_HOST=azure
# OPENAI_API_VERSION=2024-02-01

# Option 2: Hugging Face (Free - using OpenAI-compatible endpoint)
# AZURE_SEARCH_SERVICE=your-search-service-name
# AZURE_SEARCH_INDEX=your-index-name
# OPENAI_HOST=openai
# OPENAI_API_KEY=hf_YOUR_HUGGING_FACE_TOKEN
# See: https://huggingface.co/docs/api-inference/en/quicktour#running-inference-with-openai-compatible-endpoints

# Option 3: Local Hugging Face or Ollama (Free - no API key needed)
# AZURE_SEARCH_SERVICE=your-search-service-name
# AZURE_SEARCH_INDEX=your-index-name
# OPENAI_HOST=local
# OPENAI_ENDPOINT=http://localhost:8000/v1
# Note: Set up Ollama or llama.cpp with OpenAI-compatible API
# Docker example: docker run -p 8000:8000 ollama/ollama serve

# Option 4: Local Development Stub (For testing without Azure)
# This is the fastest way to test locally
AZURE_SEARCH_SERVICE=test-search-service
AZURE_SEARCH_INDEX=test-index
OPENAI_HOST=local
OPENAI_ENDPOINT=http://localhost:8000/v1
BRAIN_HOST=0.0.0.0
BRAIN_PORT=50505
BRAIN_DEBUG=true

# ============================================================================
# OPTIONAL: AGENTIC KNOWLEDGE BASE (Advanced)
# ============================================================================
# USE_AGENTIC_KNOWLEDGEBASE=false
# AZURE_SEARCH_KNOWLEDGEBASE=
# AZURE_OPENAI_KNOWLEDGEBASE_DEPLOYMENT=
# AZURE_OPENAI_KNOWLEDGEBASE_MODEL=gpt-4-turbo

# ============================================================================
# OPTIONAL: RETRIEVAL SOURCES
# ============================================================================
# USE_WEB_SOURCE=false
# USE_SHAREPOINT_SOURCE=false

# ============================================================================
# OPTIONAL: EMBEDDINGS (for Document Ingestion)
# ============================================================================
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ============================================================================
# QUERY CONFIGURATION
# ============================================================================
# QUERY_LANGUAGE=en-US
# QUERY_SPELLER=lexicon

# ============================================================================
# RAG FULL APPLICATION (if using main app.py)
# ============================================================================
# AZURE_STORAGE_ACCOUNT=your-blob-storage-account
# AZURE_STORAGE_CONTAINER=content
# AZURE_STORAGE_RESOURCE_GROUP=your-resource-group
# AZURE_COSMOSDB_ENDPOINT=
# AZURE_COSMOSDB_KEY=
# RUNNING_IN_PRODUCTION=false
# ALLOWED_ORIGIN_PATTERN=http://localhost:*
